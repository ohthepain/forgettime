{
  "name": "forgettime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3030",
    "build": "vp build",
    "start": "node server-production.mjs",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.audio-tools.json",
    "test": "vp test run",
    "test:watch": "vp test",
    "db:generate": "drizzle-kit generate",
    "db:up": "docker compose up -d",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "cap:prepare": "node scripts/prepare-capacitor.mjs",
    "cap:sync": "pnpm cap:prepare && cap sync",
    "cap:sync:android": "pnpm cap:prepare && cap sync android",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "audio:compare": "node --import tsx scripts/compare-audio.ts",
    "audio:fixtures:check": "node --import tsx scripts/check-audio-fixtures.ts",
    "audio:parity": "node --import tsx plugins/forgettime-audio/tests/validate-parity.ts",
    "audio:mel-parity": "node --import tsx plugins/forgettime-audio/tests/validate-mel-parity.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "3.1034.0",
    "@better-auth/drizzle-adapter": "1.6.6",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.2",
    "@hono/node-server": "1.19.11",
    "@tanstack/react-router": "1.168.23",
    "@tanstack/react-start": "1.167.42",
    "better-auth": "1.6.6",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "forgettime-audio": "file:plugins/forgettime-audio",
    "hono": "4.12.14",
    "lucide-react": "0.545.0",
    "pg": "8.20.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.6.2",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@tailwindcss/vite": "4.2.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.17",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "drizzle-kit": "0.31.11",
    "jsdom": "28.1.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ],
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@1.2.0",
      "vitest@*": "5.0.4"
    }
  }
}
