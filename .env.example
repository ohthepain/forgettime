DATABASE_URL=postgresql://forgettime:forgettime@localhost:5434/forgettime
BETTER_AUTH_URL=http://localhost:3030
# Generate a unique value with: openssl rand -base64 32
BETTER_AUTH_SECRET=
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Optional Google OAuth and SES email delivery; use Forgettime's own credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AWS_REGION=eu-central-1
SES_FROM_EMAIL=
TRUSTED_ORIGINS=
# Native shell loads your HTTPS deployment, following Logmaster's remote model.
CAP_REMOTE_APP_URL=
# For native development only: a reachable LAN address, not phone localhost.
CAP_DEV_SERVER_URL=
